entrypoint = "main.py"
modules = ["python-3.11"]

hidden = [".pythonlibs"]
run = "python3 nuke-bot.py"

[nix]
channel = "stable-23_05"

[env]
LANG = "en_US.UTF-8"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Bot and Verify Server"

[[workflows.workflow]]
name = "Run Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python nuke-bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Run Bot and Verify Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
